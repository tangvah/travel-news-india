---
import TrackerTabs from '../components/TrackerTabs.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Base from '../layouts/Base.astro'; import Flag from '../components/Flag.astro';
import { routes } from '../routes-data';
import { u, dest } from '../lib';
import { visaUpdated, routesUpdated, monthYear, dayLong, VISA_MAP as MAP, visaRuleLabel as ruleLabel, visaGroup as GROUP, visaRows as rows, visaFee as fee } from '../trackers';
import { SITE } from '../site.config.mjs';
const GROUPS = [['all', 'All'], ['free', 'Visa-free'], ['online', 'e-Visa, ETA & on arrival'], ['visa', 'Visa required']];
const day = (s) => new Date(s + 'T00:00:00+05:30').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' });
const host = (s) => new URL(s).hostname.replace(/^www\./, '');
const labels = (list) => { const seen = {}; return list.map((s) => { const h = host(s); seen[h] = (seen[h] || 0) + 1; return seen[h] > 1 ? `${h} (${seen[h]})` : h; }); };
const names = rows.map((r) => r.destination);
const lead = names.slice(0, 3).map((n) => n.split(' / ').pop());
const title = `Visa for Indians: ${lead.join(', ')} & more (updated ${monthYear(visaUpdated)})`;
const description = `Visa rules for Indian passport holders in ${rows.length} destinations (${names.join(', ')}): max stay, fees and conditions, checked against official sources. Last updated ${dayLong(visaUpdated)}.`;
const pageUrl = new URL(u('/visa-tracker/'), SITE.url).href;
const jsonld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Dataset', name: 'Visa rules for Indian passport holders', description, url: pageUrl, dateModified: visaUpdated, inLanguage: 'en-IN',
    creator: { '@type': 'Organization', name: SITE.name }, isAccessibleForFree: true, spatialCoverage: names, keywords: ['visa', 'India', 'Indian passport', ...names] },
  { '@type': 'ItemList', name: 'Visa rules by destination', numberOfItems: rows.length,
    itemListElement: rows.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: `${r.destination}: ${ruleLabel(r.rule_type)}`, url: `${pageUrl}#${r.id}` })) },
] };
const filterCss = GROUPS.slice(1).map(([g]) => `.tracker:has(input[value=${g}]:checked) :is(.vt,.vr):not([data-group=${g}]){display:none}`).join('');
// Sort keys for the desktop table: days as a number where the rule states one, else blank (sorts last).
const stayDays = (s) => { const m = s && String(s).match(/^(?:up to\s+)?(\d+)\s*days?/i); return m ? m[1] : ''; };
const feeKey = (f) => (f == null || f.amount == null ? '' : `${f.currency ?? ''} ${String(f.amount).padStart(10, '0')}`);
---
<Base title={title} description={description} jsonld={jsonld}>
<div class="wrap section tracker">
  <Breadcrumbs items={[{ name: 'Visa tracker', href: u('/visa-tracker/') }]} />
  <TrackerTabs path={Astro.url.pathname} variant="switch" />
  <h1>Visa tracker</h1>
  <p class="meta">Entry rules for Indian ordinary passport holders, each checked against official sources. Maintained by the Travel News Desk. Always confirm with the official source before travel.</p>
  <p class="meta"><strong>Last updated <time datetime={visaUpdated}>{dayLong(visaUpdated)}</time></strong></p>
  <nav aria-label="Jump to destination" class="chips" style="margin:0 0 16px">{rows.map((r) => <a class="chip dest" href={`#${r.id}`}>{r.destination}</a>)}</nav>
  <fieldset class="seg"><legend class="sr-only">Filter by entry rule</legend>
    {GROUPS.map(([v, l], i) => <label><input type="radio" name="vf" value={v} checked={i === 0} /><span>{l}</span></label>)}
  </fieldset>
  <div class="table-wrap vt-desk" role="region" aria-labelledby="vt-cap" tabindex="0"><table class="rt vtt" data-sortable>
    <caption id="vt-cap" class="sr-only">Visa rules for Indian ordinary passport holders by destination. Column headers sort the table.</caption>
    <thead><tr><th scope="col">Destination</th><th scope="col">Entry rule</th><th scope="col">Max stay</th><th scope="col">Fee</th><th scope="col">Effective</th><th scope="col">Last checked</th><th scope="col" data-nosort>Details</th></tr></thead>
    <tbody>{rows.map((r) => { const [flag, slug] = MAP[r.id] ?? ['', '']; const g = GROUP(r.rule_type); return (
      <tr class="vr" data-group={g}>
        <th scope="row" data-sort={r.destination.toLowerCase()}><span class="rt-route">{flag && <Flag code={flag} size={18} />}{slug ? <a href={u(`/destinations/${slug}/`)}>{r.destination}</a> : r.destination}</span></th>
        <td data-sort={`${g === 'free' ? 0 : g === 'online' ? 1 : 2} ${ruleLabel(r.rule_type)}`}><span class={`st st-${g}`}>{ruleLabel(r.rule_type)}</span></td>
        <td data-sort={stayDays(r.max_stay)} class="vtt-stay">{r.max_stay ?? 'Not stated'}</td>
        <td data-sort={feeKey(r.fee)}>{fee(r.fee)}</td>
        <td data-sort={r.effective_date ?? ''}>{r.effective_date ? <time datetime={r.effective_date}>{day(r.effective_date)}</time> : 'Not stated'}</td>
        <td data-sort={r.last_checked}><time datetime={r.last_checked}>{day(r.last_checked)}</time></td>
        <td><a href={`#${r.id}`}>Details<span class="sr-only"> for {r.destination}</span></a></td>
      </tr>); })}</tbody>
  </table><p class="sr-only sort-status" role="status" aria-live="polite"></p></div>
  <h2 class="vt-details-h">Conditions and official sources</h2>
  <ul class="vt-grid" role="list">
    {rows.map((r) => { const [flag, slug] = MAP[r.id] ?? ['', '']; return (
      <li class="vt" id={r.id} data-group={GROUP(r.rule_type)}>
        <div class="vt-head">{flag && <Flag code={flag} size={30} />}<h2>{slug ? <a href={u(`/destinations/${slug}/`)}>{r.destination}</a> : r.destination}</h2><span class={`st st-${GROUP(r.rule_type)}`}>{ruleLabel(r.rule_type)}</span></div>
        <dl class="vt-facts">
          <div><dt>Max stay</dt><dd>{r.max_stay ?? 'Not stated'}</dd></div>
          <div><dt>Fee</dt><dd>{fee(r.fee)}{r.fee?.applies_to && <small>{r.fee.applies_to}</small>}</dd></div>
          <div><dt>Effective</dt><dd>{r.effective_date ? day(r.effective_date) : 'Not stated'}</dd></div>
          <div><dt>Purpose</dt><dd>{r.purpose}, {r.passport_type} passport</dd></div>
        </dl>
        {r.key_conditions?.length > 0 && <ul class="vt-cond">{r.key_conditions.map((k) => <li>{k}</li>)}</ul>}
        {r.quote && <blockquote class="vt-quote">“{r.quote}”</blockquote>}
        {r.notes && <p class="meta vt-notes"><strong>Notes:</strong> {r.notes}</p>}
        <p class="vt-src"><span class="meta">Sources:</span> {(() => { const L = labels(r.sources); return r.sources.map((s, i) => <>{i > 0 && ' · '}<a href={s} rel="noopener">{L[i]}</a></>); })()}</p>
        <p class="meta">Last checked <time datetime={r.last_checked}>{day(r.last_checked)}</time></p>
      </li>); })}
  </ul>

  <h2 id="routes" style="margin-top:48px">New routes from India</h2>
  <p class="meta">Last updated <time datetime={routesUpdated}>{dayLong(routesUpdated)}</time>. {routes.length} verified routes, including {routes.slice(0, 3).map((r) => `${r.origin.city} → ${r.destination.city}`).join(', ')}. Start dates, frequency, aircraft, filters and a CSV download are on the routes tracker.</p>
  <p><a class="btn" href={u('/routes/')}>Open the flight routes tracker</a></p>
</div>
<style set:html={filterCss}></style>
</Base>
