---
import { u } from "../lib";
import { fmt, readingTime, cat, dest, isVerified } from '../lib';
import Flag from './Flag.astro';
const { e, morph = false } = Astro.props; const d = e.data; const c = cat(d.category);
---
<article class={`card bar-${c.color}`}>
  <div class="chips">
    {d.draft && <span class="badge-draft">DRAFT</span>}
    <a class={`chip ${c.color}`} href={u(`/category/${c.slug}/`)}>{c.name}</a>
    {d.destinations.map((s) => { const x = dest(s); return <a class="chip dest" href={u(`/destinations/${s}/`)}><Flag code={x.flag} size={16} />{x.name}</a>; })}
  </div>
  <h3 transition:name={morph ? `t-${e.id}` : undefined}><a href={u(`/news/${e.id}/`)}>{d.title}</a></h3>
  <p>{d.summary}</p>
  <div class="meta"><time datetime={d.date.toISOString()}>{fmt(d.date)}</time> · {readingTime(e.body)} min read{isVerified(d) && <> · <span class="badge-ok">✓ Verified</span></>}</div>
</article>
