---
// Build-time climate chart: inline SVG (no JS). Bars = rain (mm), lines = average high/low (°C).
import { cityClimate, MON, MONTHS } from '../seasons';
const { city, id } = Astro.props;
const c = cityClimate(city);
const W = 340, H = 200, L = 30, R = 34, T = 20, B = 26, pw = W - L - R, ph = H - T - B, slot = pw / 12;
let tMin = 0, tMax = 0, rMax = 0, ticks: number[] = [], rTicks: number[] = [];
if (c) {
  const lo = Math.min(...c.months.map((m) => m.low)), hi = Math.max(...c.months.map((m) => m.high));
  tMin = Math.floor((lo - 2) / 5) * 5; tMax = Math.ceil((hi + 2) / 5) * 5;
  const step = tMax - tMin > 25 ? 10 : 5; for (let t = tMin; t <= tMax; t += step) ticks.push(t);
  if (c.showRain) { const mx = Math.max(...c.months.map((m) => m.rain ?? 0)); const st = mx > 300 ? 200 : mx > 120 ? 100 : 20; rMax = Math.max(st, Math.ceil(mx / st) * st); for (let r = 0; r <= rMax; r += st) rTicks.push(r); }
}
const x = (i: number) => L + slot * i + slot / 2;
const yT = (t: number) => T + ph - ((t - tMin) / (tMax - tMin)) * ph;
const yR = (r: number) => T + ph - (r / rMax) * ph;
const line = (k: 'high' | 'low') => c!.months.map((m, i) => `${x(i).toFixed(1)},${yT(m[k]).toFixed(1)}`).join(' ');
const r1 = (n: number) => Math.round(n);
const desc = c && `Average highs ${r1(Math.min(...c.months.map((m) => m.high)))}–${r1(Math.max(...c.months.map((m) => m.high)))} °C, lows ${r1(Math.min(...c.months.map((m) => m.low)))}–${r1(Math.max(...c.months.map((m) => m.low)))} °C${c.showRain ? `; rain ${r1(Math.min(...c.months.map((m) => m.rain)))}–${r1(Math.max(...c.months.map((m) => m.rain)))} mm a month` : '; rain not shown'}.`;
const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-IN');
---
{c && (
<figure class="cc">
  <figcaption><b>{c.city}</b><span class="meta">{desc}</span></figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>{`${c.city} monthly climate chart. ${desc}`}</title>
    {ticks.map((t) => <g class="cc-grid"><line x1={L} x2={W - R} y1={yT(t)} y2={yT(t)} /><text x={L - 5} y={yT(t) + 3.5} text-anchor="end">{t}°</text></g>)}
    {c.showRain && rTicks.map((r) => <text class="cc-rt" x={W - R + 5} y={yR(r) + 3.5}>{r}</text>)}
    {c.showRain && c.months.map((m, i) => <rect class="cc-rain" x={x(i) - slot * 0.3} y={yR(m.rain)} width={slot * 0.6} height={Math.max(0, T + ph - yR(m.rain))} rx="2" />)}
    <polyline class="cc-hi" points={line('high')} />
    <polyline class="cc-lo" points={line('low')} />
    {c.months.map((m, i) => <><circle class="cc-hi-d" cx={x(i)} cy={yT(m.high)} r="2.6" /><circle class="cc-lo-d" cx={x(i)} cy={yT(m.low)} r="2.6" /></>)}
    {MON.map((m, i) => <text class="cc-m" x={x(i)} y={H - 9} text-anchor="middle">{m[0]}</text>)}
    {c.showRain && <text class="cc-rt" x={W - 2} y={9} text-anchor="end">mm</text>}
  </svg>
  <p class="cc-key meta"><span class="k-hi">High °C</span><span class="k-lo">Low °C</span>{c.showRain ? <span class="k-rain">Rain mm</span> : <span>Rain not shown: model rainfall for this mountain city is unreliable.</span>}</p>
  <details class="cc-data"><summary>Monthly figures for {c.city}</summary>
    <div class="cc-tw"><table><caption class="sr-only">{c.city} monthly averages</caption><thead><tr><th scope="col">Month</th><th scope="col">High °C</th><th scope="col">Low °C</th>{c.showRain && <th scope="col">Rain mm</th>}</tr></thead>
    <tbody>{c.months.map((m, i) => <tr><th scope="row">{MONTHS[i]}</th><td>{fmt1(m.high)}</td><td>{fmt1(m.low)}</td>{c.showRain && <td>{fmt1(m.rain)}</td>}</tr>)}</tbody></table></div>
  </details>
  <p class="cc-src meta">Temperatures: {c.official && c.tempSrc === c.official.source ? <a href={c.official.url} rel="noopener">{c.tempSrc}</a> : c.tempSrc}.{c.showRain && <> Rain: {c.official && c.rainSrc === c.official.source ? <a href={c.official.url} rel="noopener">{c.rainSrc}</a> : c.rainSrc}.</>}{c.offSummary && <> Official summary (<a href={c.official.url} rel="noopener">{c.official.source}</a>): {c.offSummary}.</>}</p>
</figure>)}
