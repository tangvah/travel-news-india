---
// Visible breadcrumb trail + matching BreadcrumbList JSON-LD. items: [{ name, href }]; the last item is the current page.
import { u } from '../lib';
const { items = [] } = Astro.props;
const trail = [{ name: 'Home', href: u('/') }, ...items];
const abs = (h: string) => new URL(h, Astro.site).href;
const jsonld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, item: abs(t.href) })) };
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>{trail.map((t, i) => i < trail.length - 1
    ? <li><a href={t.href}>{t.name}</a></li>
    : <li><span aria-current="page" title={t.name}>{t.name}</span></li>)}</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
