---
// IO Monogram: "I" bar + "O" orbit ring, indigo satellite dot (outbound journey). Light + dark variants; CSS shows one.
const { size = 44 } = Astro.props;
---
<svg class="logo-mark lm-l" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect width="48" height="48" rx="10" fill="#0d0d10"/><rect x="9" y="12" width="6" height="24" rx="1" fill="#ffffff"/><circle cx="30" cy="24" r="10" fill="none" stroke="#ffffff" stroke-width="6"/><circle cx="38.6" cy="15.4" r="3.6" fill="#8b9cff" stroke="#0d0d10" stroke-width="1.6"/></svg><svg class="logo-mark lm-d" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect width="48" height="48" rx="10" fill="#1b1b20"/><rect x="9" y="12" width="6" height="24" rx="1" fill="#ededf0"/><circle cx="30" cy="24" r="10" fill="none" stroke="#ededf0" stroke-width="6"/><circle cx="38.6" cy="15.4" r="3.6" fill="#9ea6ff" stroke="#1b1b20" stroke-width="1.6"/></svg>
