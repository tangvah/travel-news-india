---
// Simplified inline SVG flags (decorative; the country name is always shown as text).
const { code, size = 28 } = Astro.props;
const h = Math.round(size * 2 / 3);
---
<svg class="flag" width={size} height={h} viewBox="0 0 30 20" aria-hidden="true" focusable="false">
{code==='th' && <><rect width="30" height="20" fill="#a51931"/><rect y="3.33" width="30" height="13.33" fill="#f4f5f8"/><rect y="6.67" width="30" height="6.67" fill="#2d2a4a"/></>}
{code==='sg' && <><rect width="30" height="10" fill="#ef3340"/><rect y="10" width="30" height="10" fill="#fff"/><circle cx="6" cy="5" r="3.2" fill="#fff"/><circle cx="7.2" cy="5" r="3" fill="#ef3340"/><g fill="#fff"><circle cx="9" cy="3" r=".6"/><circle cx="10.6" cy="4.2" r=".6"/><circle cx="10" cy="6.2" r=".6"/><circle cx="8" cy="6.2" r=".6"/><circle cx="7.4" cy="4.2" r=".6"/></g></>}
{code==='ae' && <><rect width="30" height="6.67" fill="#00732f"/><rect y="6.67" width="30" height="6.67" fill="#fff"/><rect y="13.33" width="30" height="6.67" fill="#000"/><rect width="8" height="20" fill="#ff0000"/></>}
{code==='vn' && <><rect width="30" height="20" fill="#da251d"/><polygon fill="#ffcd00" points="15,4 16.8,9.5 22.6,9.5 17.9,12.9 19.7,18.4 15,15 10.3,18.4 12.1,12.9 7.4,9.5 13.2,9.5"/></>}
{code==='id' && <><rect width="30" height="10" fill="#ce1126"/><rect y="10" width="30" height="10" fill="#fff"/></>}
{code==='my' && <><rect width="30" height="20" fill="#fff"/>{[0,2,4,6,8,10,12].map(i=> <rect y={i*1.43} width="30" height="1.43" fill="#cc0001"/>)}<rect width="15" height="11.4" fill="#010066"/><circle cx="6" cy="5.7" r="3.6" fill="#fc0"/><circle cx="7.1" cy="5.7" r="3" fill="#010066"/><polygon fill="#fc0" points="11,3.3 11.6,5 13.4,5 12,6.1 12.5,7.8 11,6.8 9.5,7.8 10,6.1 8.6,5 10.4,5"/></>}
{code==='lk' && <><rect width="30" height="20" fill="#ffb700"/><rect x="1" y="1" width="3.5" height="18" fill="#005f56"/><rect x="4.5" y="1" width="3.5" height="18" fill="#ff5b00"/><rect x="9" y="1" width="20" height="18" fill="#8d153a"/></>}
{code==='jp' && <><rect width="30" height="20" fill="#fff"/><circle cx="15" cy="10" r="6" fill="#bc002d"/></>}
{code==='kr' && <><rect width="30" height="20" fill="#fff"/><path d="M15 6.4a3.6 3.6 0 0 1 0 7.2a1.8 1.8 0 0 1 0-3.6a1.8 1.8 0 0 0 0-3.6z" fill="#cd2e3a"/><path d="M15 6.4a3.6 3.6 0 0 0 0 7.2a1.8 1.8 0 0 0 0-3.6a1.8 1.8 0 0 1 0-3.6z" fill="#0047a0"/><g fill="#000"><rect x="5.2" y="3.4" width="4" height=".7" transform="rotate(-33.7 7.2 3.75)"/><rect x="5.6" y="4.4" width="4" height=".7" transform="rotate(-33.7 7.6 4.75)"/><rect x="20.8" y="15.2" width="4" height=".7" transform="rotate(-33.7 22.8 15.55)"/><rect x="20.4" y="14.2" width="4" height=".7" transform="rotate(-33.7 22.4 14.55)"/><rect x="20.6" y="3.6" width="4" height=".7" transform="rotate(33.7 22.6 3.95)"/><rect x="5.4" y="15" width="4" height=".7" transform="rotate(33.7 7.4 15.35)"/></g></>}
{code==='sa' && <><rect width="30" height="20" fill="#006c35"/><rect x="8" y="12.5" width="14" height="1" fill="#fff"/></>}
{code==='mv' && <><rect width="30" height="20" fill="#d21034"/><rect x="5" y="4" width="20" height="12" fill="#007e3a"/><circle cx="16" cy="10" r="3.5" fill="#fff"/><circle cx="17.3" cy="10" r="3.2" fill="#007e3a"/></>}
{code==='bt' && <><polygon points="0,0 30,0 0,20" fill="#ffd520"/><polygon points="30,0 30,20 0,20" fill="#ff4e12"/><circle cx="15" cy="10" r="3" fill="#fff"/></>}
{code==='np' && <><rect width="30" height="20" fill="#fff"/><polygon points="9,1 21,10 12,10 21,19 9,19" fill="#dc143c" stroke="#003893" stroke-width="1"/><circle cx="12" cy="7" r="1.5" fill="#fff"/><circle cx="12" cy="15" r="1.5" fill="#fff"/></>}
<rect width="30" height="20" fill="none" stroke="rgba(0,0,0,.15)"/>
</svg>
