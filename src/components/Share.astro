---
// Share UI: plain links, no third-party scripts. Brand glyphs from simple-icons (CC0), inlined at build time.
import { siWhatsapp, siX, siFacebook, siTelegram } from 'simple-icons';
const { url, title, variant = 'rail' } = Astro.props; // variant: rail | card
const eu = encodeURIComponent(url), t = encodeURIComponent(title);
const LI = 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z';
const MAIL = 'M2 5h20v14H2zM2 5l10 8 10-8';
const LINK = 'M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5';
const SHARE = 'M12 3v12M7 8l5-5 5 5M5 13v7h14v-7';
const links = [
  ['WhatsApp', `https://wa.me/?text=${t}%20${eu}`, siWhatsapp.path, 'fill'],
  ['X', `https://x.com/intent/post?text=${t}&url=${eu}`, siX.path, 'fill'],
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${eu}`, siFacebook.path, 'fill'],
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${eu}`, LI, 'fill'],
  ['Telegram', `https://t.me/share/url?url=${eu}&text=${t}`, siTelegram.path, 'fill'],
  ['Email', `mailto:?subject=${t}&body=${eu}`, MAIL, 'stroke'],
];
const ico = (d, mode) => mode === 'fill'
  ? `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="${d}"/></svg>`
  : `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="${d}"/></svg>`;
const card = variant === 'card';
---
<div class={card ? 'share-row' : 'share-rail'} role="group" aria-label="Share this story">
  {!card && <span class="share-label" aria-hidden="true">Share</span>}
  {links.map(([n, h, d, m]) => <a class={`sh sh-${n.toLowerCase()}`} href={h} rel="noopener" target="_blank"><Fragment set:html={ico(d, m)} /><span class={card ? '' : 'sr-only'}>{n}</span><span class="sr-only"> (opens in new tab)</span></a>)}
  <button class="sh copy-btn" type="button" data-copy={url}><Fragment set:html={ico(LINK, 'stroke')} /><span class={card ? '' : 'sr-only'}>Copy link</span></button>
  <button class="sh webshare" type="button" data-webshare={url} data-title={title}><Fragment set:html={ico(SHARE, 'stroke')} /><span class={card ? '' : 'sr-only'}>More options</span></button>
</div>
