---
import { u } from "../lib";
import { SITE, DESTINATIONS, CATEGORIES } from '../site.config.mjs';
const { title, description = SITE.tagline, type = 'website', image, jsonld, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={u("/rss.xml")} />
<link rel="sitemap" href={u("/sitemap-index.xml")} />
<meta property="og:site_name" content={SITE.name} /><meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} /><meta property="og:type" content={type} />
<meta property="og:url" content={canonical} /><meta property="og:locale" content={SITE.locale} />
{image && <meta property="og:image" content={new URL(u(image), Astro.site)} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<style is:global>
:root{--ink:#1b1f24;--muted:#5b6470;--accent:#c2410c;--bg:#fff;--line:#e5e7eb}
*{box-sizing:border-box}body{margin:0;font:16px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);background:var(--bg)}
a{color:var(--accent)}.wrap{max-width:1040px;margin:0 auto;padding:0 16px}
header{border-bottom:3px solid var(--accent)}.brand{display:block;font-weight:800;font-size:1.3rem;color:var(--ink);text-decoration:none;padding:12px 0 4px}
nav{display:flex;gap:12px;overflow-x:auto;padding:6px 0 10px;font-size:.9rem;white-space:nowrap}nav a{color:var(--muted);text-decoration:none}nav a:hover{color:var(--accent)}
.grid{display:grid;gap:16px;grid-template-columns:1fr}@media(min-width:720px){.grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}}
.card{border:1px solid var(--line);border-radius:8px;padding:14px}.card h3{margin:.2em 0;font-size:1.1rem}.card h3 a{color:var(--ink);text-decoration:none}
.meta{color:var(--muted);font-size:.85rem}.pill{display:inline-block;background:#fff7ed;color:var(--accent);border-radius:99px;padding:0 8px;font-size:.75rem;margin-right:4px;text-decoration:none}
.draft{display:inline-block;background:#dc2626;color:#fff;font-weight:700;font-size:.75rem;padding:0 8px;border-radius:4px;margin-right:4px}.ph{background:#fefce8;border:1px dashed #ca8a04;padding:12px;border-radius:8px}
.menu{display:none;padding-bottom:10px}.menu summary{cursor:pointer;font-weight:600;padding:6px 10px;border:1px solid var(--line);border-radius:6px;display:inline-block;list-style:none}.menu summary::-webkit-details-marker{display:none}
.menu nav{flex-direction:column;gap:2px;white-space:normal}.menu nav a{padding:6px 0;color:var(--ink)}.menu strong{margin-top:8px;font-size:.75rem;text-transform:uppercase;color:var(--muted)}
@media(max-width:719px){nav.desk{display:none}.menu{display:block}}
article{max-width:720px}footer{margin-top:48px;border-top:1px solid var(--line);padding:16px 0;color:var(--muted);font-size:.85rem}
</style>
</head>
<body>
<header><div class="wrap"><a class="brand" href={u("/")}>{SITE.name}</a>
<nav class="desk" aria-label="Main">{DESTINATIONS.map(d=> <a href={u(`/destinations/${d.slug}/`)}>{d.name}</a>)}<span>|</span>{CATEGORIES.map(c=> <a href={u(`/category/${c.slug}/`)}>{c.name}</a>)}</nav>
<details class="menu"><summary aria-label="Menu">☰ Menu</summary>
<nav aria-label="Mobile"><strong>Destinations</strong>{DESTINATIONS.map(d=> <a href={u(`/destinations/${d.slug}/`)}>{d.name}</a>)}
<strong>Categories</strong>{CATEGORIES.map(c=> <a href={u(`/category/${c.slug}/`)}>{c.name}</a>)}
<strong>Site</strong><a href={u("/about/")}>About</a><a href={u("/contact/")}>Contact</a></nav></details></div></header>
<main class="wrap"><slot /></main>
<footer><div class="wrap">© {new Date().getFullYear()} {SITE.name} · <a href={u("/about/")}>About</a> · <a href={u("/contact/")}>Contact</a> · <a href={u("/rss.xml")}>RSS</a></div></footer>
</body></html>
