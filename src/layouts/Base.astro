---
import { u } from "../lib";
import '@fontsource-variable/inter-tight/index.css';
import '@fontsource-variable/sora/index.css';
import '../styles/global.css';
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Flag from '../components/Flag.astro';
import Logo from '../components/Logo.astro';
import TrackerTabs from '../components/TrackerTabs.astro';
import { SITE, DESTINATIONS, CATEGORIES, TOOLS } from '../site.config.mjs';
import { allNews } from '../lib';
const { title, description = SITE.tagline, type = 'website', image, ogImage, jsonld, noindex = false } = Astro.props;
const og = ogImage ?? new URL(u(image || '/og-default.png'), Astro.site).href;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const norm = (p: string) => p.replace(/\/?$/, '/');
const cur = (href: string) => (norm(path) === norm(href) ? 'page' : undefined);
const latest = (await allNews()).slice(0, 8);
const today = new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<script is:inline>
(function(){var d=document.documentElement;d.classList.add('js');if(navigator.share)d.classList.add('can-share');
function pick(){try{var s=localStorage.getItem('theme');if(s==='dark'||s==='light')return s}catch(e){}return matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}
d.dataset.theme=pick();
if(window.__iotn)return;window.__iotn=1;
document.addEventListener('astro:before-swap',function(e){var n=e.newDocument.documentElement;n.dataset.theme=pick();n.classList.add('js');if(navigator.share)n.classList.add('can-share')});
document.addEventListener('click',function(e){
 var t=e.target.closest&&e.target.closest('[data-theme-toggle]');
 if(t){var next=document.documentElement.dataset.theme==='dark'?'light':'dark';var apply=function(){document.documentElement.dataset.theme=next};var r=t.getBoundingClientRect();var de=document.documentElement;de.style.setProperty('--vx',(r.left+r.width/2)+'px');de.style.setProperty('--vy',(r.top+r.height/2)+'px');if(document.startViewTransition&&!matchMedia('(prefers-reduced-motion: reduce)').matches){de.classList.add('theme-vt');document.startViewTransition(apply).finished.finally(function(){de.classList.remove('theme-vt')})}else apply();try{localStorage.setItem('theme',next)}catch(_){};t.setAttribute('aria-pressed',String(next==='dark'));return}
 var c=e.target.closest&&e.target.closest('[data-copy]');
 if(c&&navigator.clipboard){navigator.clipboard.writeText(c.dataset.copy).then(function(){var o=document.getElementById('toast');if(o){o.textContent='Copied';o.classList.add('show');clearTimeout(window.__tt);window.__tt=setTimeout(function(){o.classList.remove('show');o.textContent=''},2200)}});return}
 var w=e.target.closest&&e.target.closest('[data-webshare]');
 if(w&&navigator.share){navigator.share({title:w.dataset.title,url:w.dataset.webshare}).catch(function(){})}
});})();
</script>
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={interTightLatin} as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
<link rel="icon" href={u("/favicon-32.png")} sizes="32x32" type="image/png" />
<link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
<link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
<link rel="manifest" href={u("/site.webmanifest")} />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={u("/rss.xml")} />
<link rel="sitemap" href={u("/sitemap-index.xml")} />
<meta property="og:site_name" content={SITE.name} /><meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} /><meta property="og:type" content={type} />
<meta property="og:url" content={canonical} /><meta property="og:locale" content={SITE.locale} />
<meta property="og:image" content={og} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={og} />
<meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<ClientRouter />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header>
  {latest.length > 0 && (
  <div class="ticker" role="region" aria-label="Latest headlines">
    <div class="wrap"><span class="label">LATEST</span>
      <div class="track"><ul>
        {latest.map((e) => <li><a href={u(`/news/${e.id}/`)}>{e.data.title}</a></li>)}
        {latest.map((e) => <li aria-hidden="true"><a href={u(`/news/${e.id}/`)} tabindex="-1">{e.data.title}</a></li>)}
      </ul></div></div>
  </div>)}
  <div class="masthead">
    <div class="wrap">
      <div class="mast-row">
        <a class="brand brand-v2" href={u("/")}><Logo size={46} /><span class="bt"><b>India Outbound <span>Travel</span> News</b><small>{today} · {SITE.tagline}</small></span></a>
        <TrackerTabs path={path} />
        <div class="mast-tools">
          <button class="btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode" aria-pressed="false">
            <span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span></button>
          <details class="menu">
            <summary class="btn" aria-label="Menu"><span aria-hidden="true">☰</span> Menu</summary>
            <nav class="menu-panel" aria-label="Mobile menu">
              <div><strong class="eyebrow">Trackers</strong><ul>{TOOLS.map((t) => <li><a href={u(t.href)} aria-current={cur(u(t.href))}>{t.name}</a></li>)}</ul></div>
              <div><strong class="eyebrow">Sections</strong><ul>{CATEGORIES.map((c) => <li><a href={u(`/category/${c.slug}/`)}>{c.name}</a></li>)}</ul></div>
              <div><strong class="eyebrow">Destinations</strong><ul>{DESTINATIONS.map((d) => <li><a href={u(`/destinations/${d.slug}/`)}><Flag code={d.flag} size={22} />{d.name}</a></li>)}</ul></div>
              <div><strong class="eyebrow">Site</strong><ul><li><a href={u("/about/")}>About</a></li><li><a href={u("/contact/")}>Contact</a></li></ul></div>
            </nav>
          </details>
        </div>
      </div>
      <nav class="nav-primary" aria-label="Sections">
        <a href={u("/")} aria-current={cur(u('/'))}>Latest</a>
        {CATEGORIES.map((c) => <a href={u(`/category/${c.slug}/`)} aria-current={cur(u(`/category/${c.slug}/`))}>{c.name}</a>)}
      </nav>
      <nav class="nav-dest" aria-label="Destinations">
        {DESTINATIONS.map((d) => <a href={u(`/destinations/${d.slug}/`)} aria-current={cur(u(`/destinations/${d.slug}/`))}><Flag code={d.flag} size={21} />{d.name}</a>)}
      </nav>
    </div>
  </div>
</header>
<main id="main" tabindex="-1"><slot /></main>
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div><p class="brand" style="margin:0"><b style="font-size:1.3rem">India Outbound <span>Travel</span> News</b></p><p class="meta">{SITE.tagline}.</p></div>
      <div><h2>Sections</h2><ul>{CATEGORIES.map((c) => <li><a href={u(`/category/${c.slug}/`)}>{c.name}</a></li>)}</ul></div>
      <div><h2>Destinations</h2><ul>{DESTINATIONS.map((d) => <li><a href={u(`/destinations/${d.slug}/`)}>{d.name}</a></li>)}</ul></div>
      <div><h2>More</h2><ul>{TOOLS.map((t) => <li><a href={u(t.href)}>{t.name}</a></li>)}<li><a href={u("/about/")}>About</a></li><li><a href={u("/contact/")}>Contact</a></li><li><a href={u("/newsletter/")}>Newsletter</a></li><li><a href={u("/rss.xml")}>RSS feed</a></li></ul></div>
    </div>
    <p class="legal">© {new Date().getFullYear()} {SITE.name}. Fonts: Sora &amp; Inter Tight (SIL OFL). <a href={u("/about/#credits")}>Credits</a></p>
  </div>
</footer>
</body></html>
